# Each preview is served from the root of an origin of its own,
# http://<id>--<port>.localhost:5173, so that client-side routers see the path
# their server sees (ADR-0044). Chromium and Firefox resolve *.localhost to this
# machine without configuration; set another value or an empty one to change it.
VITE_PREVIEW_ORIGIN=http://*.localhost:5173
